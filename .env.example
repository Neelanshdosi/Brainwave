# ==========================================
# BRAINWAVE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini API Key (Server-Side Only)
# Powers batch embeddings (gemini-embedding-001), Grounded Briefing Agent, and "Ask the Brain" Q&A.
# Never expose with NEXT_PUBLIC_.
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. NewsData.io API Key (Server-Side Only)
# Powers live headline ingestion from NewsData.io.
# Obtain a key at: https://newsdata.io/
NEWSDATA_API_KEY=your_newsdata_api_key_here

# 3. Optional: Hugging Face API Key
# Fallback summarization API key.
# Obtain a token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# 4. Optional: Global Daily AI Operation Cap (Default: 200)
AI_DAILY_CAP=200
